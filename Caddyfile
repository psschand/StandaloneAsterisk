# HTTPS server for frontend on port 443
app.soham.top {
	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Allow microphone and camera for WebRTC softphone
		Permissions-Policy "geolocation=(), microphone=(self), camera=(self)"
	}

	# Backend API - proxy to containerized backend
	handle /api/* {
		reverse_proxy backend:8001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# Audio files - proxy to backend for TTS and recordings
	handle /audio/* {
		reverse_proxy backend:8001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Call recordings - proxy to backend
	handle /recordings/* {
		reverse_proxy backend:8001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# WebSocket Secure (WSS) proxy for Asterisk WebRTC
	# Handle WebSocket connections to /ws endpoint
	handle /ws {
		reverse_proxy asterisk:8088 {
			# Disable buffering for WebSocket streaming
			flush_interval -1
			# Pass WebSocket upgrade headers
			header_up Host {host}
			header_up X-Real-IP {remote_host}
		}
	}

	# Frontend - serve static files (must be last, catches all remaining routes)
	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto https
	}

	# Logs
	log {
		output stdout
		format json
	}
}

# Backend API server on port 8443 (separate)
app.soham.top:8443 {

	# Backend API - proxy to containerized backend
	handle /api/* {
		reverse_proxy backend:8001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# WebSocket for backend
	handle /ws* {
		reverse_proxy backend:8001 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto https
		}
	}

	# Adminer database management
	handle /adminer* {
		reverse_proxy adminer:8080
	}

	# Health check endpoint
	handle /health {
		respond "OK" 200
	}

	# Root endpoint - API info
	handle / {
		respond "CallCenter Backend API - Healthy" 200
	}

	# Catch all - redirect to API docs or return 404
	handle {
		respond "CallCenter Backend API - Use /api/v1 endpoints" 404
	}

	# Logs
	log {
		output stdout
		format json
	}
}
