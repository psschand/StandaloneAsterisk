[mysqld]
# Character Set
character-set-server=utf8mb4
collation-server=utf8mb4_unicode_ci

# Connection Settings - Optimized for low resource usage
max_connections=100
max_allowed_packet=32M
max_connect_errors=10000
wait_timeout=600
interactive_timeout=600

# Thread Cache - Reduce thread creation overhead
thread_cache_size=16
thread_stack=256K

# Table Cache
table_open_cache=2000
table_definition_cache=1000
open_files_limit=5000

# InnoDB Settings - Optimized for performance and low CPU
innodb_buffer_pool_size=384M
innodb_buffer_pool_instances=2
innodb_log_file_size=64M
innodb_log_buffer_size=16M
innodb_flush_log_at_trx_commit=2
innodb_flush_method=O_DIRECT
innodb_file_per_table=1
innodb_lock_wait_timeout=50
innodb_io_capacity=200
innodb_io_capacity_max=400
innodb_read_io_threads=4
innodb_write_io_threads=4
innodb_purge_threads=1
innodb_page_cleaners=2

# Temp Tables
tmp_table_size=32M
max_heap_table_size=32M

# Binary Logging - Optimized
server-id=1
log_bin=mysql-bin
binlog_format=ROW
binlog_expire_logs_seconds=604800
sync_binlog=0
binlog_cache_size=32K

# Slow Query Log - Disabled for performance
slow_query_log=0
long_query_time=2

# Performance Schema - Disabled to save resources
performance_schema=OFF

# Skip Name Resolution
skip-name-resolve=1

# Sort and Join Buffers
sort_buffer_size=2M
read_buffer_size=2M
read_rnd_buffer_size=4M
join_buffer_size=2M

[client]
default-character-set=utf8mb4
